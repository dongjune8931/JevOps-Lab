{
  "uid": "p001-baseline",
  "title": "P001 — Local Observability Baseline",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "p001",
    "m1"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "p001-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "p001:request_rate",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "p001-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (service) (rate(p001_requests_total{status!=\"200\"}[1m])) or (0 * sum by (service) (rate(p001_requests_total[1m])))) / sum by (service) (rate(p001_requests_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 request duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "p001-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(p001_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Synthetic logs — TraceID opens Tempo",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "p001-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"p001\"} |= \"synthetic_request\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 5,
      "title": "Recent distributed traces",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "p001-tempo"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"checkout\" }",
          "limit": 20
        }
      ]
    }
  ]
}
